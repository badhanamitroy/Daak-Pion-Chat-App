# DaakPion .gitignore

# PHP config with DB credentials — NEVER push to GitHub
php/config.php
php/db_connect.php

# Uploaded user files (can be large; recreate locally)
ProfilePics/*
Coverpics/*

# Keep the folders themselves (empty placeholder)
!ProfilePics/.gitkeep
!Coverpics/.gitkeep

# OS & editor junk
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# Antigravity / agent scratch files
daakpion_analysis_and_plan.md
daakpion_facebook_redesign_plan.md

# Security secrets and logs — NEVER push to GitHub
php/security_secrets.php
.env
logs/
vendor/
composer.phar

# Generated test emails
emails/*.html
emails/*.txt
!emails/.gitkeep
!emails/.htaccess

# Uploaded message attachments (recreate locally)
uploads/message_media/audio/*
uploads/message_media/documents/*
uploads/message_media/images/*
uploads/message_media/videos/*
!uploads/message_media/*/.gitkeep
!uploads/.htaccess

